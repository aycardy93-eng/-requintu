# Copia este archivo como .env y completa los valores.
# Nunca subas el .env real a git.

# --- Entorno ---
NODE_ENV=development

# --- Seguridad ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo

# --- Base de datos ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=requintu_db
# 'true' solo si la BD exige TLS (Aiven, TiDB Cloud, etc.)
DB_SSL=false

# --- CORS: orígenes del frontend separados por coma ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting (opcional) ---
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- Correo (recuperación de contraseña vía Brevo) ---
# Crea tu API key gratis en https://www.brevo.com (Settings → SMTP & API)
BREVO_API_KEY=xkeysib-...
# Correo que aparecerá como remitente (debe estar verificado en Brevo)
BREVO_SENDER_EMAIL=tu.correo@gmail.com

# URL pública del frontend para los enlaces del correo
# ============================================================
# Cola de correos: máx. intentos antes de marcar un correo como fallido (por defecto 5)
# EMAIL_MAX_INTENTOS=5
APP_URL=http://localhost:5173

# --- Puerto ---
PORT=3000
